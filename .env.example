# AppProbe / mobile-ai-agent configuration
# Copy to .env and fill in local values.
# Never commit .env or real API keys, tokens, passwords, or private keys.
# Test fixtures must use synthetic credentials, not production-style secrets.

APP_NAME=AppProbe
APP_ENV=development
LOG_LEVEL=INFO

# HTTP
HOST=0.0.0.0
PORT=8000

# Upload / workspace isolation
MAX_UPLOAD_BYTES=209715200
WORKSPACE_DIR=./workspace

# Reserved for Milestone 6. Leave empty until the AI layer is implemented.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
LLM_PROVIDER=

# Optional Milestone 2 tooling. AppProbe runs without these.
# MobSF is optional. Leave MOBSF_ENABLED=false unless a local MobSF is running.
MOBSF_ENABLED=false
MOBSF_URL=
MOBSF_API_KEY=
MOBSF_TIMEOUT_SECONDS=30
MOBSF_POLL_INTERVAL_SECONDS=2
MOBSF_MAX_WAIT_SECONDS=180
MOBSF_MAX_RESPONSE_BYTES=8388608
JADX_BIN=
APKTOOL_BIN=
TOOL_TIMEOUT_SECONDS=180
TOOL_MAX_OUTPUT_BYTES=1048576

# Optional OSV advisory lookups. Public API; no token required.
ADVISORY_NETWORK_ENABLED=true
OSV_BASE_URL=https://api.osv.dev
ADVISORY_TIMEOUT_SECONDS=20

# Reserved for Milestone 3
ANDROID_SDK_ROOT=
BUNDLETOOL_JAR=
