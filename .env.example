# AppProbe / mobile-ai-agent configuration
# Copy to .env and adjust. Never commit real API keys.

APP_NAME=AppProbe
APP_ENV=development
LOG_LEVEL=INFO

# HTTP
HOST=0.0.0.0
PORT=8000

# Upload / workspace isolation
MAX_UPLOAD_BYTES=209715200
WORKSPACE_DIR=./workspace

# Reserved for Milestone 6. Leave empty until the AI layer is implemented.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
LLM_PROVIDER=

# Optional Milestone 2 tooling. AppProbe runs without these.
MOBSF_URL=
MOBSF_API_KEY=
JADX_BIN=
APKTOOL_BIN=
TOOL_TIMEOUT_SECONDS=180

# Reserved for Milestone 3
ANDROID_SDK_ROOT=
BUNDLETOOL_JAR=
