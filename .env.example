# AppProbe / Mobile AI Agent configuration
# Copy to .env and adjust. Never commit real secrets.

MOBILE_AGENT_HOST=127.0.0.1
MOBILE_AGENT_PORT=8000
MOBILE_AGENT_WORKSPACE_DIR=workspace
MOBILE_AGENT_MAX_UPLOAD_BYTES=209715200
MOBILE_AGENT_MAX_UNCOMPRESSED_BYTES=838860800
MOBILE_AGENT_MAX_ZIP_ENTRIES=20000
MOBILE_AGENT_SUBPROCESS_TIMEOUT_SECONDS=120
MOBILE_AGENT_LOG_LEVEL=INFO

# Reserved for Milestone 6 (AI reasoning). Leave empty in Milestone 1.
MOBILE_AGENT_LLM_API_KEY=
MOBILE_AGENT_LLM_MODEL=
MOBILE_AGENT_LLM_BASE_URL=
